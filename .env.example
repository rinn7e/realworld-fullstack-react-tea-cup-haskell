# Copy to .env (never commit it). Used by `docker compose` and the make vps-* targets.

# --- VPS only (make vps-env writes these) ---
# Run behind the droplet's shared HTTPS proxy (github.com/rinn7e/caddy-front).
# Locally leave both unset: docker-compose.override.yml serves http://localhost:3000.
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
# Site address(es) the proxy serves over HTTPS
# DOMAIN=realworld.example.com

# PostgreSQL
POSTGRES_DB=realworld
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Signing key for login tokens (at least 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=local-dev-secret-that-is-at-least-32-chars-long

# SSH target of the VPS (your Mac only), used by make vps-env / vps-deploy / vps-set-env
# VPS_TARGET=root@203.0.113.10

# Image pulled by docker compose. Forks: CI publishes ghcr.io/<your-github-owner>/<repo-name>
# IMAGE=ghcr.io/rinn7e/realworld-fullstack-react-tea-cup-haskell

# Image tag pulled by docker compose (default: latest). Use a commit SHA to pin or
# roll back, or `localtest` for an image built locally with `docker build -t ...:localtest`.
# IMAGE_TAG=latest
