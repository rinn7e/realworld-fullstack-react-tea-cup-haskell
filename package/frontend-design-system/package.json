{
  "name": "@rinn7e/realworld-design-system",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "RealWorld design system library built with Tailwind CSS and react-tea-cup TEA architecture",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.js"
    },
    "./component/*": {
      "types": "./dist/component/*/index.d.ts",
      "import": "./dist/component/*/index.mjs",
      "require": "./dist/component/*/index.js"
    },
    "./component/*/*": {
      "types": "./dist/component/*/*.d.ts",
      "import": "./dist/component/*/*.mjs",
      "require": "./dist/component/*/*.js"
    },
    "./element/*": {
      "types": "./dist/element/*/index.d.ts",
      "import": "./dist/element/*/index.mjs",
      "require": "./dist/element/*/index.js"
    },
    "./element/*/*": {
      "types": "./dist/element/*/*.d.ts",
      "import": "./dist/element/*/*.mjs",
      "require": "./dist/element/*/*.js"
    },
    "./form/*": {
      "types": "./dist/form/*/index.d.ts",
      "import": "./dist/form/*/index.mjs",
      "require": "./dist/form/*/index.js"
    },
    "./form/*/*": {
      "types": "./dist/form/*/*.d.ts",
      "import": "./dist/form/*/*.mjs",
      "require": "./dist/form/*/*.js"
    },
    "./grid/*": {
      "types": "./dist/grid/*/index.d.ts",
      "import": "./dist/grid/*/index.mjs",
      "require": "./dist/grid/*/index.js"
    },
    "./grid/*/*": {
      "types": "./dist/grid/*/*.d.ts",
      "import": "./dist/grid/*/*.mjs",
      "require": "./dist/grid/*/*.js"
    },
    "./layout/*": {
      "types": "./dist/layout/*/index.d.ts",
      "import": "./dist/layout/*/index.mjs",
      "require": "./dist/layout/*/index.js"
    },
    "./layout/*/*": {
      "types": "./dist/layout/*/*.d.ts",
      "import": "./dist/layout/*/*.mjs",
      "require": "./dist/layout/*/*.js"
    },
    "./type/*": {
      "types": "./dist/type/*.d.ts",
      "import": "./dist/type/*.mjs",
      "require": "./dist/type/*.js"
    }
  },
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "build": "vite build && pnpm run showcase:build",
    "check": "tsc --noEmit",
    "check-circular": "madge --circular lib/",
    "clean": "rimraf dist node_modules/.cache",
    "format": "prettier --write .",
    "lint": "eslint lib/",
    "test": "echo \"no tests\"",
    "staged": "pnpm run format && pnpm run check && pnpm run check-circular && pnpm run lint && pnpm run test",
    "showcase:dev": "cd app/showcase-app && npm run dev",
    "showcase:build": "cd app/showcase-app && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fp-ts": "^2.16.11",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-tea-cup": "^5.1.3",
    "tailwind-merge": "^3.0.1",
    "tea-cup-fp": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.14.0",
    "madge": "^8.0.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
