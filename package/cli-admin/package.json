{
  "name": "tea-cup-realworld-admin-cli",
  "private": true,
  "version": "1.0.0",
  "description": "The admin dashboard in the terminal, a port of frontend-admin",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sentinel-admin": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.tsx",
    "start": "node dist/main.js",
    "build": "tsup",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "check-circular": "madge --circular --ts-config ./tsconfig.json --extensions ts,tsx src/",
    "format": "prettier --write .",
    "test": "vitest run",
    "staged": "pnpm run format && pnpm run check && pnpm run check-circular && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@devexperts/remote-data-ts": "^2.1.1",
    "@rinn7e/tea-cup-pagination": "^1.0.2",
    "@rinn7e/tea-cup-prelude": "^1.0.2",
    "fp-ts": "^2.16.0",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "io-ts": "^2.2.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tea-cup": "5.1.1",
    "tea-cup-fp": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.2.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.11"
  }
}
