{
  "name": "tea-cup-realworld-admin-core",
  "private": true,
  "version": "1.0.0",
  "description": "The Model, Msg, update and API of the admin dashboard, shared by its web and CLI apps",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "check-circular": "madge --circular --ts-config ./tsconfig.json --extensions ts src/",
    "format": "prettier --write .",
    "test": "vitest run",
    "staged": "pnpm run format && pnpm run check && pnpm run check-circular && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@devexperts/remote-data-ts": "^2.1.1",
    "@rinn7e/tea-cup-pagination": "^1.0.2",
    "@rinn7e/tea-cup-prelude": "^1.0.2",
    "fp-ts": "^2.16.0",
    "io-ts": "^2.2.21",
    "tea-cup-fp": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^20.3.3",
    "@types/react": "^19.1.8",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.2.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.11"
  }
}
