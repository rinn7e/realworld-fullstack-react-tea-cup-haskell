<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />

  <!-- The backend of development is plain HTTP on this Mac (10.0.2.2 from the
       emulator, the LAN IP from a phone) -->
  <application
    android:label="Sentinel"
    android:icon="@android:drawable/ic_lock_lock"
    android:usesCleartextTraffic="true"
    android:theme="@android:style/Theme.Material.NoActionBar">

    <!-- configChanges: the activity is kept on a rotation or a theme change,
         so the runtime and its model are kept too -->
    <activity
      android:name="app.MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- Deep links: sentinel://users is /users of the web app -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="sentinel" />
      </intent-filter>
    </activity>
  </application>
</manifest>
